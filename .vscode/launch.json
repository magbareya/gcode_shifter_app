{
    "version": "0.2.0",
    "configurations": [

         {
            "name": "Streamlit Debug",
            "type": "debugpy",
            "request": "launch",
            "module": "streamlit",
            "args": [
                "run",
                "${file}",
                "--server.port",
                "8501",
            ],
            "env": {
                "STREAMLIT_DEVELOP_MODE": "true"
            }
        },
        {
            "name": "Attach to Streamlit",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 5678
            },
            "justMyCode": true
        }
    ]
}